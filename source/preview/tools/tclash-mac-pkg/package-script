#!/bin/sh
set -eu
umask 077

case "$(/usr/bin/basename "$0")" in
  preinstall) mode=--preflight ;;
  postinstall) mode=--postflight ;;
  *) exit 1 ;;
esac

if [ "$(/usr/bin/id -u)" != 0 ] || [ "${3:-}" != / ]; then
  exit 1
fi

script_dir=$(/usr/bin/dirname "$0")
user=$(/usr/bin/stat -f '%Su' /dev/console)
case "$user" in ""|root|loginwindow|_*) exit 1 ;; esac
uid=$(/usr/bin/id -u "$user")
home=$(/usr/bin/dscl . -read "/Users/$user" NFSHomeDirectory | /usr/bin/sed -n 's/^NFSHomeDirectory: //p')
case "$home" in /*) ;; *) exit 1 ;; esac
[ -d "$home" ] || exit 1

stage=$(/usr/bin/mktemp -d /private/tmp/tclash-package.XXXXXXXX)
trap '/bin/rm -rf "$stage"' EXIT HUP INT TERM
/bin/cp "$script_dir/tclash-pkg-helper" "$stage/helper"
/bin/cp "$script_dir/enrollment.json" "$stage/enrollment.json"
/bin/chmod 700 "$stage" "$stage/helper"
/bin/chmod 600 "$stage/enrollment.json"
/usr/sbin/chown "$uid" "$stage" "$stage/helper" "$stage/enrollment.json"

/bin/launchctl asuser "$uid" /usr/bin/sudo -H -u "$user" /usr/bin/env HOME="$home" \
  "$stage/helper" "$mode" "$stage/enrollment.json" "$home" '/Applications/TClash Preview.app'
